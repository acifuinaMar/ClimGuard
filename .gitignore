# Credenciales y variables locales
.env
.env.*
!.env.example

# Certificados y llaves
nginx/certs/
*.pem
*.pfx
*.key

# Dependencias y compilaciones
**/node_modules/
**/dist/
**/bin/
**/obj/
**/target/
**/.angular/

# Archivos del entorno local
.vs/
.vscode/
*.log

# Configuraciones heredadas pendientes de revisión
/ClimGuard Backend/API/appsettings.json
/ClimGuard Backend/API/appsettings.Development.json

# Kubernetes: k8s/climguard.yaml se versiona (generado, revisado, SIN secretos).
# Los secretos nunca se guardan en k8s/: se crean con scripts/k8s-secrets.sh desde un .env fuera del repo.
/k8s/*.env
/k8s/*secret*.yaml
/k8s/*tls*.yaml

# Cachés generadas por Python
__pycache__/
*.py[cod]

# Respaldos locales y bases de datos
/backups/
*.dump

# Archivos generados por las pruebas de Auth
/services/auth/dist-test/