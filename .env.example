# =====================================================================
#  AlertaClima — plantilla de variables de entorno
# =====================================================================
#  CÓMO USARLO:
#     1. Copia este archivo y renombra la copia a  .env
#     2. Reemplaza cada CAMBIAME por un valor real
#     3. NUNCA subas el .env a git (ya está en .gitignore)
#
#  ¿Por qué existe este archivo?
#  Porque el .env real tiene contraseñas y NO se sube al repositorio.
#  Sin esta plantilla, quien clone el proyecto no sabría qué variables
#  necesita definir. Esto documenta el "contrato" sin filtrar secretos.
# =====================================================================

# ---------------------------------------------------------------------
# SQL SERVER
# ---------------------------------------------------------------------
# Requisitos de la contraseña SA (los impone SQL Server, no nosotros):
# mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.
MSSQL_SA_PASSWORD=CAMBIAME_Cl4ve$egura
MSSQL_DB_NAME=AlertaClimaDb

# ---------------------------------------------------------------------
# JWT  (el "pase de entrada" que la API le da al navegador)
# ---------------------------------------------------------------------
# El doble guion bajo __ es la forma en que .NET convierte una variable
# de entorno en configuración anidada:  JWT__ISSUER  ->  Jwt:Issuer
JWT__ISSUER=AlertaClima.Api
JWT__AUDIENCE=AlertaClima.Frontend

# La llave de firma es EL secreto más importante del sistema:
# quien la tenga puede fabricar tokens y entrar como administrador.
# Mínimo 32 caracteres. Genera una aleatoria, no la inventes a mano.
JWT__SIGNINGKEY=CAMBIAME_minimo_32_caracteres_aleatorios

# Duración del token de acceso, en minutos. Corto a propósito:
# si te lo roban, caduca rápido.
JWT__ACCESSTOKENMINUTES=15

# Duración del refresh token, en días. Largo, pero es revocable.
JWT__REFRESHTOKENDAYS=7

# ---------------------------------------------------------------------
# USUARIO ADMINISTRADOR INICIAL (datos semilla)
# ---------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@alertaclima.local
SEED_ADMIN_PASSWORD=CAMBIAME_Admin123$
SEED_OPERATOR_EMAIL=operador@alertaclima.local
SEED_OPERATOR_PASSWORD=CAMBIAME_Oper123$

# ---------------------------------------------------------------------
# CORS  (qué origen tiene permiso de llamar a la API)
# ---------------------------------------------------------------------
# Nunca uses "*" junto con credenciales: es un agujero de seguridad.
CORS__ALLOWEDORIGINS__0=http://localhost:4200

# ---------------------------------------------------------------------
# SIMULADOR DE SENSORES
# ---------------------------------------------------------------------
# Cada cuántos segundos el sistema genera una lectura nueva.
SIMULATOR__INTERVALSECONDS=5
SIMULATOR__ENABLED=true
