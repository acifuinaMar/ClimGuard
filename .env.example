# ClimGuard Fase 3 — plantilla. Genera un .env con secretos aleatorios: ./scripts/gen-env.sh
# NUNCA subas .env a git.

# ---- JWT compartido (emite Auth; validan Gateway y todos los servicios) ----
JWT_KEY=CAMBIAME_minimo_32_bytes_aleatorios______
JWT_ISSUER=climguard-auth
JWT_AUDIENCE=climguard-api
JWT_EXPIRATION_MINUTES=30

# ---- Llave para llamadas servicio-a-servicio (auditoría, evaluación de alertas) ----
INTERNAL_API_KEY=CAMBIAME_aleatoria

# ---- Bases de datos (una por servicio) ----
POSTGRES_SUPERUSER_PASSWORD=CAMBIAME
AUTH_DB_PASSWORD=CAMBIAME
COMMUNITY_DB_PASSWORD=CAMBIAME
ALERT_DB_PASSWORD=CAMBIAME
MSSQL_SA_PASSWORD=CAMBIAME_Cl4ve$egura      # SQL Server exige mayúscula, minúscula, número y símbolo
MONGO_ROOT_PASSWORD=CAMBIAME

# ---- Datos demo (poner en false para entornos reales) ----
SEED_DEMO=true                # comunidades, sensores y reglas de ejemplo
SEED_DEFAULT_USERS=true       # usuarios de demostración (solo desarrollo local; nunca en producción)
SIMULATOR_ENABLED=true        # lecturas simuladas cada 5 s, SOLO para sensores con origen SIMULADO activos

# ---- Reportes ----
REPORT_TIMEZONE=America/Guatemala
# Valores iniciales conservadores (NO medidos con WeasyPrint real; ver RECURSOS-VPS.md para medir y ajustar):
REPORT_MAX_ROWS=100           # VALOR INICIAL DE PRODUCCIÓN. No subir hasta medir con WeasyPrint real en el VPS (RECURSOS-VPS.md)
REPORT_ON_LIMIT=fail          # fail | truncate (truncate recorta, y lo advierte en el PDF y en el historial)
REPORT_CHUNK_ROWS=250         # filas por trozo de PDF
REPORT_CONCURRENCY=1          # PDFs generándose a la vez (cada uno consume RAM)
REPORT_MAX_QUEUE=4            # reportes PENDING+PROCESSING permitidos; más → HTTP 429
REPORT_LOOKUP_MAX_ROWS=5000   # tope de los catálogos de apoyo (sensores/comunidades)

# ---- Borde (nginx) ----
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=8443
CORS_ORIGINS=https://localhost:8443,http://localhost:4200

# ---- Fase 4: OAuth 2.0 / OIDC (Google, GitHub). Vacío = deshabilitado; el login local no depende de esto ----
# URL pública que ve el navegador (sin "/" final). Con ella se arman los redirect URI:
#   {OAUTH_PUBLIC_BASE_URL}/api/auth/oauth/google/callback   y   .../github/callback
# OJO: en variables VACÍAS no pongas comentarios en la misma línea; Docker Compose toma el "# ..." como valor.
OAUTH_PUBLIC_BASE_URL=
# Opcional; por defecto igual a OAUTH_PUBLIC_BASE_URL
OAUTH_FRONTEND_URL=
OAUTH_AUTO_PROVISION=false                # true = crea usuarios nuevos con rol Consulta (nunca Administrador)
# Opcional: dominios que pueden auto-registrarse, ej. uni.edu,empresa.com
OAUTH_ALLOWED_EMAIL_DOMAINS=
# Los *_CLIENT_SECRET NUNCA van al repositorio
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DB_SYNCHRONIZE=false                       # false en producción: aplicar scripts/migrations/auth-*.sql
