{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": "http://localhost:4200,https://localhost"
  },
  "RateLimit": {
    "PerMinute": 300,
    "LoginPerMinute": 10
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "login",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/login"
        }
      },
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "authenticated",
        "Order": 1,
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "users": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/users/{**rest}"
        }
      },
      "communities": {
        "ClusterId": "community",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/communities/{**rest}"
        }
      },
      "sensors": {
        "ClusterId": "sensor",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/sensors/{**rest}"
        }
      },
      "sensor-meta": {
        "ClusterId": "sensor",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/{kind:regex(^(readings|sensor-types|sensor-states|simulation)$)}/{**rest}"
        }
      },
      "alerts": {
        "ClusterId": "alert",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/alerts/{**rest}"
        }
      },
      "alert-meta": {
        "ClusterId": "alert",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/{kind:regex(^(levels|phenomena|alert-states|rules)$)}/{**rest}"
        }
      },
      "reports": {
        "ClusterId": "report",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/reports/{**rest}"
        }
      },
      "audit": {
        "ClusterId": "audit",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/audit/{**rest}"
        }
      },
      "hubs": {
        "ClusterId": "sensor",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/hubs/{**rest}"
        }
      },
      "login-legacy": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/api/login"
        }
      },
      "usuario-legacy": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/Usuario/{**rest}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": {
            "Address": "http://auth-service:3000/"
          }
        }
      },
      "community": {
        "Destinations": {
          "d1": {
            "Address": "http://community-service:8080/"
          }
        }
      },
      "sensor": {
        "Destinations": {
          "d1": {
            "Address": "http://sensor-service:8080/"
          }
        }
      },
      "alert": {
        "Destinations": {
          "d1": {
            "Address": "http://alert-service:8080/"
          }
        }
      },
      "report": {
        "HttpRequest": {
          "ActivityTimeout": "00:05:00"
        },
        "Destinations": {
          "d1": {
            "Address": "http://report-service:8000/"
          }
        }
      },
      "audit": {
        "Destinations": {
          "d1": {
            "Address": "http://audit-service:8000/"
          }
        }
      }
    }
  }
}