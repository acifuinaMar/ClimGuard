
{
  "ReverseProxy": {
    "Routes": {
      "reports": {
        "ClusterId": "reports",
        "Order": -10,
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      },
      "audit": {
        "ClusterId": "audit",
        "Order": -10,
        "Match": {
          "Path": "/api/audit/{**catch-all}"
        }
      },
      "legacy": {
        "ClusterId": "legacy",
        "Order": 0,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "legacy": {
        "Destinations": {
          "d1": {
            "Address": "http://api:8080/"
          }
        }
      },
      "reports": {
        "Destinations": {
          "d1": {
            "Address": "http://report-service:8000/"
          }
        }
      },
      "audit": {
        "Destinations": {
          "d1": {
            "Address": "http://audit-service:8000/"
          }
        }
      }
    }
  }
}
